
import statistics

def clean_data(values):
    cleaned = []

    for value in values:
        try:
            number = float(value)

            if 0 <= number <= 999:
                cleaned.append(number)

        except (ValueError, TypeError):
            continue

    return cleaned

def min_max(values):
    if not values:
        return []

    minimum = min(values)
    maximum = max(values)

    if minimum == maximum:
        return [0.0 for _ in values]

    return [
        round((x - minimum) / (maximum - minimum), 3)
        for x in values
    ]

def z_score(values):
    if len(values) < 2:
        return [0.0 for _ in values]

    mean = statistics.mean(values)
    sd = statistics.stdev(values)

    if sd == 0:
        return [0.0 for _ in values]

    return [round((x - mean) / sd, 3) for x in values]

def fahrenheit_to_celsius(f):
    return round((f - 32) * 5 / 9, 2)

data = ["48", "NA", "-5", "95", "121", "1200"]

cleaned = clean_data(data)

print("Cleaned data:", cleaned)
print("Min-Max:", min_max(cleaned))
print("Z-Score:", z_score(cleaned))
print("Temperature:", fahrenheit_to_celsius(98.6), "C")

